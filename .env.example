# HeelonBackup Environment Variables
# Copy this file to .env and fill in your credentials
# This file is in .gitignore and will NOT be committed to git

# Required SMB connection settings
HEELONBACKUP_SMB_URL=smb://your-nas-ip/share_name
HEELONBACKUP_SMB_USERNAME=your_username
HEELONBACKUP_SMB_PASSWORD=your_secure_password

# Optional SMB settings
HEELONBACKUP_SMB_WORKGROUP=WORKGROUP
HEELONBACKUP_SMB_TIMEOUT=60
HEELONBACKUP_SMB_ENCRYPT=true

# Logging level (debug, info, warn, error)
RUST_LOG=heelonbackup=info

# Example for your NAS at 192.168.1.22:
# HEELONBACKUP_SMB_URL=smb://192.168.1.22/backup
# HEELONBACKUP_SMB_USERNAME=backup_user
# HEELONBACKUP_SMB_PASSWORD=your_secure_password
# HEELONBACKUP_SMB_WORKGROUP=WORKGROUP
